<Window x:Class="VIBN_Tools.IbnRemote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VIBN Tools – IBN Remote"
        Width="1540" Height="840" MinWidth="1050" MinHeight="600"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="IBN Remote" />
                <TextBlock Foreground="#FF666666"
                           Text="Schlanker, schreibgeschützter Arbeitsplatzüberblick mit Remote-Desktop-Verbindung." />
            </StackPanel>
            <Button DockPanel.Dock="Right" Width="120" Height="36" Margin="8,0,0,0"
                    Content="Aktualisieren" Command="{Binding RefreshCommand}" />
        </DockPanel>

        <Border Grid.Row="1" Margin="0,0,0,10" Padding="10" Background="#FFF3F5F7" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox MinHeight="34" Padding="8,4" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="PC, Projekt, Software, Standort, Projekt-IP, Sonstiges oder Benutzer filtern" />
                <StackPanel Grid.Column="1" Margin="18,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Monitore:" />
                    <CheckBox Content="1" IsChecked="{Binding UseMonitor1}" />
                    <CheckBox Margin="10,0,0,0" Content="2" IsChecked="{Binding UseMonitor2}" IsEnabled="{Binding HasMonitor2}" />
                    <CheckBox Margin="10,0,0,0" Content="3" IsChecked="{Binding UseMonitor3}" IsEnabled="{Binding HasMonitor3}" />
                    <CheckBox Margin="10,0,0,0" Content="4" IsChecked="{Binding UseMonitor4}" IsEnabled="{Binding HasMonitor4}" />
                </StackPanel>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding SourceStatus}" />
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  RowHeight="34" ColumnHeaderHeight="38" FrozenColumnCount="1"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PC" Binding="{Binding PcName}" Width="150" />
                <DataGridTemplateColumn Header="Online" Width="82">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Margin="3" Padding="5,3" Background="{Binding OnlineBackground}" CornerRadius="3">
                                <TextBlock HorizontalAlignment="Center" Text="{Binding OnlineStatus}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Belegung" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Margin="3" Padding="5,3" Background="{Binding OccupancyBackground}" CornerRadius="3">
                                <TextBlock HorizontalAlignment="Center" Text="{Binding Occupancy}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Projekte (Planung / in Arbeit)" Binding="{Binding Projects}" Width="260" />
                <DataGridTextColumn Header="Software" Binding="{Binding Software}" Width="190" />
                <DataGridTextColumn Header="Standort" Binding="{Binding Location}" Width="120" />
                <DataGridTextColumn Header="Projekt-IP" Binding="{Binding ProjectIp}" Width="120" />
                <DataGridTextColumn Header="Sonstiges" Binding="{Binding Other}" Width="190" />
                <DataGridTextColumn Header="Benutzer" Binding="{Binding UserName}" Width="155" />
                <DataGridTextColumn Header="RDP-Sitzung" Binding="{Binding RemoteSession}" Width="165" />
                <DataGridTextColumn Header="Letzte Anmeldung" Binding="{Binding LastLogon}" Width="190" />
                <DataGridTemplateColumn Header="Verbindung" Width="285">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button MinWidth="115" Padding="6,3" Content="Remote (Auto)"
                                        Command="{Binding DataContext.ConnectAutomaticCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" IsEnabled="{Binding CanConnect}"
                                        ToolTip="Verwendet VIBN_RDP_PASSWORD nur temporär im Windows-Anmeldemanager." />
                                <Button MinWidth="130" Margin="6,0,0,0" Padding="6,3" Content="RDP mit Dialog"
                                        Command="{Binding DataContext.ConnectWithPromptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" IsEnabled="{Binding CanConnect}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="10,7" Background="#FFF3F5F7" CornerRadius="3">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
