<UserControl x:Class="VIBN_Tools.Application.View.Fee2ContainerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VIBN_Tools.Application.VM"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    <UserControl.DataContext>
        <vm:Fee2ContainerPageVM />
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="FEE2Container" />
            <TextBlock Margin="0,7,0,0" TextWrapping="Wrap"
                       Text="Liest ausschließlich BasicFrames mit versionierter Container2FEE-Provenienz. Ältere oder manuell erstellte FEE-Modelle werden bewusst nicht heuristisch rekonstruiert." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,10" Orientation="Horizontal">
            <Button MinWidth="150" MinHeight="34"
                    Content="FEE-Roots einlesen"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding CanRefresh}"
                    ToolTip="{Binding RefreshUnavailableReason}"
                    ToolTipService.ShowOnDisabled="True" />
            <Button Margin="8,0,0,0" MinWidth="165" MinHeight="34"
                    Content="ContainerFile exportieren"
                    Command="{Binding ExportCommand}"
                    IsEnabled="{Binding CanExport}"
                    ToolTip="{Binding ExportUnavailableReason}"
                    ToolTipService.ShowOnDisabled="True" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding SelectionSummary}" />
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="FEE-Root" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="GUID" Binding="{Binding Guid}" Width="2*" />
                <DataGridTextColumn Header="Container" Binding="{Binding ContainerCount}" Width="*" />
                <DataGridTextColumn Header="Signale" Binding="{Binding SignalCount}" Width="*" />
                <DataGridTextColumn Header="Aktuell gelesen" Binding="{Binding UpdatedSignalCount}" Width="*" />
                <DataGridTextColumn Header="Fehlend" Binding="{Binding MissingSignalCount}" Width="*" />
                <DataGridTextColumn Header="Slotrouten" Binding="{Binding UpdatedSlotCount}" Width="*" />
                <DataGridTextColumn Header="Slot ungeklärt" Binding="{Binding UnresolvedSlotCount}" Width="*" />
                <DataGridTextColumn Header="Quellfingerprint" Binding="{Binding Provenance.SourceFingerprint}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <ItemsControl Grid.Row="3" Margin="0,8,0,0" ItemsSource="{Binding Issues}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Foreground="DarkRed" TextWrapping="Wrap" Text="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="4" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding StatusText}" />
    </Grid>
</UserControl>
