<Project>
  <Target Name="ResolveFeeScreenSimSdkVersion"
          BeforeTargets="ValidateFeeScreenSimSdk;GenerateAssemblyInfo"
          Condition="'$(MSBuildProjectName)' == 'VIBN_Tools' and Exists('$(FeeScreenSimBinPath)\FS.SDK.dll')">
    <GetAssemblyIdentity AssemblyFiles="$(FeeScreenSimBinPath)\FS.SDK.dll">
      <Output TaskParameter="Assemblies" ItemName="_FeeSdkIdentity" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <FeeScreenSimSdkVersion>@(_FeeSdkIdentity->'%(Version)')</FeeScreenSimSdkVersion>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Remove="FeeSdkVersion" />
      <AssemblyMetadata Include="FeeSdkVersion" Value="$(FeeScreenSimSdkVersion)" />
    </ItemGroup>
  </Target>

  <Target Name="ValidateFeeScreenSimSdk"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(MSBuildProjectName)' == 'VIBN_Tools'">
    <Error Condition="'$(FeeScreenSimRoot)' == '' and '$(_HasMultipleInstalledFeeSdks)' == 'True'"
           Text="Mehrere vollständige FEE-SDK-Versionen wurden gefunden. Prepare-Development.cmd starten, SDK auswählen und Visual Studio neu starten; ohne Auswahl verwendet Build.ps1 die höchste Version." />
    <Error Condition="'$(FeeScreenSimBinPath)' == '' or !Exists('$(FeeScreenSimBinPath)\FS.SDK.dll')"
           Text="Kein vollständiges FEE-SDK gefunden. Unterstützt werden Installationsordner mit Bin\FS.SDK.dll und der unveränderte Repository-Ordner SDK\FS.SDK.dll. Build.ps1 verwenden oder FEE_SCREEN_SIM_ROOT setzen." />
    <Error Condition="'$(FeeReadingUnitPluginPath)' == '' or !Exists('$(FeeReadingUnitPluginPath)')"
           Text="ReadingUnitPlugin.dll fehlt im ausgewählten FEE-SDK. Erwartet unter Bin\Plugins\ReadingUnitPlugin oder direkt im flachen Repository-SDK." />
    <Message Condition="Exists('$(FeeScreenSimBinPath)\FS.SDK.dll')"
             Importance="High"
             Text="FEE SDK erkannt: Version $(FeeScreenSimSdkVersion) unter '$(FeeScreenSimBinPath)'." />
  </Target>
</Project>
