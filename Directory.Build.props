<Project>
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Pin the language independently from the installed SDK. This prevents
         new contextual keywords from changing an otherwise identical build. -->
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <!-- One override replaces all version-specific FS.* HintPaths. The build
       script discovers the newest installed version and passes this property. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'VIBN_Tools'">
    <FeeScreenSimRoot Condition="'$(FEE_SCREEN_SIM_ROOT)' != ''">$(FEE_SCREEN_SIM_ROOT)</FeeScreenSimRoot>
    <FeeScreenSimRoot Condition="'$(FeeScreenSimRoot)' == '' and Exists('$(MSBuildThisFileDirectory)external\fe-screen-sim\Bin\FS.SDK.dll')">$(MSBuildThisFileDirectory)external\fe-screen-sim</FeeScreenSimRoot>
    <FeeScreenSimRoot Condition="'$(FeeScreenSimRoot)' == ''">C:\Program Files\fe.screen-sim V5\5.0.11.48415</FeeScreenSimRoot>
  </PropertyGroup>
</Project>
