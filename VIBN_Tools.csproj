<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- The legacy VIBN application predates nullable flow analysis. Keep
         annotations available without producing hundreds of false-positive
         initialization warnings; new boundary projects remain nullable-strict. -->
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<!-- A machine with a serviced .NET 8 Desktop Runtime (for example 8.0.30)
	     must run a build whose minimum framework version is 8.0.0. -->
	<RollForward>LatestPatch</RollForward>
	<BaseOutputPath>$(MSBuildProjectDirectory)\artifacts\build\</BaseOutputPath>
	<DefaultItemExcludes>$(DefaultItemExcludes);Tests\**;VIBN_Tools.Core\**;VIBN_Tools.Infrastructure\**;VIBN_Tools.Tia.Client\**;VIBN_Tools.Tia.Contracts\**;VIBN_Tools.TiaBridge\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Content\LogicDefinitions\GrobStandard\Grob_AxisBeckhoff.xml" />
  </ItemGroup>


  <ItemGroup>
    <Content Include="NLog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ContainerGeneration\XmlSchemas\AutoCreate.xsd" />
    <EmbeddedResource Include="ContainerGeneration\XmlSchemas\CAAResult.xsd" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Content\LogicDefinitions\CustomerSpecific\BMW\" />
    <Folder Include="Content\LogicDefinitions\CustomerSpecific\Ford\" />
    <Folder Include="Content\LogicDefinitions\CustomerSpecific\Mercedes\" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="ClosedXML" Version="0.105.0" />
	<PackageReference Include="Grob.UX" Version="1.8.93" />
	<PackageReference Include="Microsoft.ML" Version="5.0.0" />
	<PackageReference Include="Microsoft.ML.LightGbm" Version="5.0.0" />
	<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
	<PackageReference Include="NLog.Extensions.Logging" Version="6.1.0" />
    <PackageReference Include="NPOI" Version="2.7.5" />
    <!-- Required at runtime by the FEE SDK; declare it explicitly so a
         deployed desktop build does not depend on a machine-wide GAC entry. -->
    <PackageReference Include="System.ComponentModel.Composition" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="VIBN_Tools.Core\VIBN_Tools.Core.csproj" />
    <ProjectReference Include="VIBN_Tools.Infrastructure\VIBN_Tools.Infrastructure.csproj" />
    <ProjectReference Include="VIBN_Tools.Tia.Client\VIBN_Tools.Tia.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="FS.API">
      <HintPath>$(FeeScreenSimRoot)\Bin\FS.API.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="FS.Components">
      <HintPath>$(FeeScreenSimRoot)\Bin\FS.Components.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="FS.Content">
      <HintPath>$(FeeScreenSimRoot)\Bin\FS.Content.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="FS.Input">
      <HintPath>$(FeeScreenSimRoot)\Bin\FS.Input.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="FS.SDK">
      <HintPath>$(FeeScreenSimRoot)\Bin\FS.SDK.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="FS.SDK.Mathematics">
      <HintPath>$(FeeScreenSimRoot)\Bin\FS.SDK.Mathematics.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="FS.SDK.Network">
      <HintPath>$(FeeScreenSimRoot)\Bin\FS.SDK.Network.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="FS.SDK.Packets">
      <HintPath>$(FeeScreenSimRoot)\Bin\FS.SDK.Packets.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="FS.SDK.Util">
      <HintPath>$(FeeScreenSimRoot)\Bin\FS.SDK.Util.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="FS.SDK.Wpf">
      <HintPath>$(FeeScreenSimRoot)\Bin\FS.SDK.Wpf.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="FS.Util">
      <HintPath>$(FeeScreenSimRoot)\Bin\FS.Util.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ReadingUnitPlugin">
      <HintPath>$(FeeScreenSimRoot)\Bin\Plugins\ReadingUnitPlugin\ReadingUnitPlugin.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- All shipped definitions are runtime data. The wildcard also picks
         up newly added definitions without another project-file edit. -->
    <None Update="Content\**\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="BuildAndCopyTiaBridge" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)\VIBN_Tools.TiaBridge\VIBN_Tools.TiaBridge.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile" />
    <ItemGroup>
      <TiaBridgeOutput Include="$(MSBuildProjectDirectory)\VIBN_Tools.TiaBridge\bin\$(Configuration)\net48\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(TiaBridgeOutput)" DestinationFiles="@(TiaBridgeOutput->'$(TargetDir)TiaBridge\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyFeeRuntimeToOutput" AfterTargets="Build">
    <ItemGroup>
      <FeeRuntimeRootAssembly Include="$(FeeScreenSimRoot)\Bin\*.dll" />
      <FeeRuntimePluginFile Include="$(FeeScreenSimRoot)\Bin\Plugins\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FeeRuntimeRootAssembly)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FeeRuntimePluginFile)"
          DestinationFiles="@(FeeRuntimePluginFile->'$(TargetDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyTiaBridgeToPublish" AfterTargets="Publish">
    <MSBuild Projects="$(MSBuildProjectDirectory)\VIBN_Tools.TiaBridge\VIBN_Tools.TiaBridge.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile" />
    <ItemGroup>
      <TiaBridgePublishOutput Include="$(MSBuildProjectDirectory)\VIBN_Tools.TiaBridge\bin\$(Configuration)\net48\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(TiaBridgePublishOutput)"
          DestinationFiles="@(TiaBridgePublishOutput->'$(PublishDir)TiaBridge\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyFeeRuntimeToPublish" AfterTargets="Publish">
    <ItemGroup>
      <FeePublishRootAssembly Include="$(FeeScreenSimRoot)\Bin\*.dll" />
      <FeePublishPluginFile Include="$(FeeScreenSimRoot)\Bin\Plugins\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FeePublishRootAssembly)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FeePublishPluginFile)"
          DestinationFiles="@(FeePublishPluginFile->'$(PublishDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
